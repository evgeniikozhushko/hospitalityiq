# Copy to .env.local and fill in. Never commit .env.local.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Optional: model for query planning (defaults to OPENAI_CHAT_MODEL)
OPENAI_PLANNER_MODEL=
# Grades eval answers (npm run eval). Defaults to the chat model.
OPENAI_JUDGE_MODEL=

# Qdrant (local Docker by default; add QDRANT_API_KEY for Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=reviews

# Postgres (local Docker: docker compose up -d --wait, then npm run db:migrate && npm run db:setup)
# Three separate users on purpose. ADMIN writes (migrations, imports); READONLY is
# used by statistics queries; TEST is a disposable instance for integration tests.
DATABASE_URL_ADMIN=postgres://hiq_migrator:hiq_dev_admin@localhost:5433/hiq
DATABASE_URL_READONLY=postgres://hiq_app_ro:hiq_dev_readonly@localhost:5433/hiq
DATABASE_URL_TEST=postgres://hiq_migrator:hiq_test@localhost:5434/hiq_test

# LangSmith (later, Module 11)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hospitalityiq

# Google Business Profile API (later, once access is approved)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
